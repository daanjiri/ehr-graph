# Neo4j AuraDB (usa neo4j+s:// para TLS)
NEO4J_URI=neo4j+s://example.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me

# Crea una clave exclusiva para esta demo en un workspace con límite de gasto.
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_EFFORT=medium

# Genera valores aleatorios distintos de al menos 32 bytes.
CHAT_RATE_SALT=replace-with-random-secret
KEEPALIVE_TOKEN=replace-with-random-secret

CHAT_MAX_CHARS=500
CHAT_MAX_INTERCAMBIOS=3
CHAT_MAX_RONDAS_HERRAMIENTAS=4
CHAT_LIMITE_DIARIO_CLIENTE=20
CHAT_LIMITE_MENSUAL_GLOBAL=100
